# Copy to .env and fill in as needed. Everything has a working default, so the
# system runs with NO edits at all (heuristic/Ollama engine, base.en whisper).

# --- Analysis engine ---------------------------------------------------------
# auto  = Claude if ANTHROPIC_API_KEY is set, else Ollama, else heuristic
# claude | ollama | heuristic  to force one.
ANALYSIS_ENGINE=auto

# Set this to use Claude (best quality + evidence citations). Leave blank to run
# fully offline.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Ollama (offline fallback). Point at a running Ollama if you want it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Transcription -----------------------------------------------------------
# base.en (fast) | small.en (sharper, slower). tiny.en for a quick smoke test.
WHISPER_MODEL=base.en

# --- Pipeline ----------------------------------------------------------------
# Parallel worker processes for the batch run.
PIPELINE_WORKERS=4
